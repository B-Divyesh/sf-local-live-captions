{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Live Captions",
  "version": "0.1.15",
  "identifier": "in.sociobot.local-live-captions",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{
      "title": "Local Live Captions",
      "width": 920,
      "height": 680,
      "minWidth": 390,
      "minHeight": 500,
      "resizable": true,
      "alwaysOnTop": false
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Offline captions for desktop audio",
    "longDescription": "Captions selected desktop audio on the device with downloadable English and German Whisper models.",
    "copyright": "Copyright 2026 Param Factory",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
